{
  "name": "property-system-infra",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Property Management System",
  "main": "lib/index.js",
  "bin": {
    "infra": "lib/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:dev": "cdk deploy --all --context env=dev --require-approval never",
    "deploy:prod": "cdk deploy --all --context env=prod",
    "destroy": "cdk destroy --all",
    "diff": "cdk diff",
    "bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "ts-node": "^10.9.2"
  }
}
